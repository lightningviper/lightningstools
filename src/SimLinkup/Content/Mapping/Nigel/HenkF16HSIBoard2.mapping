<?xml version="1.0"?>
<MappingProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SignalMappings>
    <SignalMapping>
      <Source xsi:type="DigitalSignal">
        <Id>F4_HSI__OFF_FLAG</Id>
      </Source>
      <Destination xsi:type="DigitalSignal">
        <Id>Henk_F16_HSI_Board2__Off_Flag_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="DigitalSignal">
        <Id>F4_HSI__COURSE_DEVIATION_INVALID_FLAG</Id>
      </Source>
      <Destination xsi:type="DigitalSignal">
        <Id>Henk_F16_HSI_Board2__Deviation_Flag_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="DigitalSignal">
        <Id>F4_HSI__DISTANCE_INVALID_FLAG</Id>
      </Source>
      <Destination xsi:type="DigitalSignal">
        <Id>Henk_F16_HSI_Board2__Range_Invalid_Flag_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="DigitalSignal">
        <Id>F4_HSI__TO_FLAG</Id>
      </Source>
      <Destination xsi:type="DigitalSignal">
        <Id>Henk_F16_HSI_Board2__TO_Flag_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="DigitalSignal">
        <Id>F4_HSI__FROM_FLAG</Id>
      </Source>
      <Destination xsi:type="DigitalSignal">
        <Id>Henk_F16_HSI_Board2__FROM_Flag_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__CURRENT_HEADING_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Magnetic_Heading_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__DESIRED_HEADING_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Desired_Heading_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__DESIRED_COURSE_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Course_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__BEARING_TO_BEACON_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Bearing_From_Sim</Id>
      </Destination>
    </SignalMapping>
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__DISTANCE_TO_BEACON_NAUTICAL_MILES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Range_From_Sim</Id>
      </Destination>
    </SignalMapping>
    
	  <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__COURSE_DEVIATION_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Course_Deviation_From_Sim</Id>
      </Destination>
    </SignalMapping>
	  
    <SignalMapping>
      <Source xsi:type="AnalogSignal">
        <Id>F4_HSI__COURSE_DEVIATION_LIMIT_DEGREES</Id>
      </Source>
      <Destination xsi:type="AnalogSignal">
        <Id>Henk_F16_HSI_Board2__Course_Deviation_Limit_From_Sim</Id>
      </Destination>
    </SignalMapping>

	<!-- AUTOPILOT ENGAGED -->
	<SignalMapping>
		<!-- F4 AUTOPILOT ENGAGED FLAG OUTPUT-->
		<Source xsi:type="DigitalSignal">
			<Id>F4_MISC__AUTOPILOT_ENGAGED</Id>
		</Source>
		<!-- HENK HSI AUTOPILOT ENGAGED FLAG INPUT-->
		<Destination xsi:type="DigitalSignal">
			<Id>Henk_F16_HSI_Board2__Autopilot_Engaged_Flag_From_Sim</Id>
		</Destination>
	</SignalMapping>

	<SignalMapping>
		<Source xsi:type="AnalogSignal">
			<Id>Henk_F16_HSI_Board2__Desired_Heading_Percentage_From_Instrument</Id>
		</Source>
		<Destination xsi:type="AnalogSignal">
			<Id>TeensyEWMU__User_Axis[0]</Id>
		</Destination>
	</SignalMapping>

	<SignalMapping>
		<Source xsi:type="AnalogSignal">
			<Id>Henk_F16_HSI_Board2__Desired_Course_Percentage_From_Instrument</Id>
		</Source>
		<Destination xsi:type="AnalogSignal">
			<Id>TeensyEWMU__User_Axis[1]</Id>
		</Destination>
	</SignalMapping>	  

  </SignalMappings>
</MappingProfile>