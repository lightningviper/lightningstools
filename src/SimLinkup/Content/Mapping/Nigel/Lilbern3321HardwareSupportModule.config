<?xml version="1.0"?>
<Lilbern3321HardwareSupportModule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Channels>
    <Channel id="3321_RPM_SIN_To_Instrument">
      <Transform kind="piecewise_resolver" role="sin" partnerChannel="3321_RPM_COS_To_Instrument">
        <Breakpoints>
          <Point input="0" angle="0"/>
          <Point input="20" angle="30"/>
          <Point input="40" angle="60"/>
          <Point input="60" angle="90"/>
          <Point input="70" angle="138"/>
          <Point input="80" angle="186"/>
          <Point input="90" angle="234"/>
          <Point input="100" angle="282"/>
          <Point input="110" angle="330"/>
        </Breakpoints>
        <PeakVolts>10</PeakVolts>
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
    <Channel id="3321_RPM_COS_To_Instrument">
      <Transform kind="piecewise_resolver" role="cos" partnerChannel="3321_RPM_SIN_To_Instrument">
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
  </Channels>
</Lilbern3321HardwareSupportModule>