<?xml version="1.0"?>
<Simtek101088HardwareSupportModule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Channels>
    <Channel id="101088_Nozzle_Position_SIN_To_Instrument">
      <Transform kind="piecewise_resolver" role="sin" partnerChannel="101088_Nozzle_Position_COS_To_Instrument">
        <Breakpoints>
          <Point input="0" angle="0"/>
          <Point input="10" angle="23.5"/>
          <Point input="20" angle="47.7"/>
          <Point input="30" angle="72.1"/>
          <Point input="40" angle="96.5"/>
          <Point input="50" angle="120.1"/>
          <Point input="60" angle="146.1"/>
          <Point input="70" angle="168.6"/>
          <Point input="80" angle="194.8"/>
          <Point input="90" angle="219"/>
          <Point input="100" angle="239.5"/>
        </Breakpoints>
        <PeakVolts>10</PeakVolts>
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
    <Channel id="101088_Nozzle_Position_COS_To_Instrument">
      <Transform kind="piecewise_resolver" role="cos" partnerChannel="101088_Nozzle_Position_SIN_To_Instrument">
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
  </Channels>
</Simtek101088HardwareSupportModule>