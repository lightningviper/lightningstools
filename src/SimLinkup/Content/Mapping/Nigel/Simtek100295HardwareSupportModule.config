<?xml version="1.0"?>
<Simtek100295HardwareSupportModule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Channels>
    <Channel id="100295_Fuel_Flow_To_Instrument">
      <Transform kind="piecewise">
        <Breakpoints>
          <Point input="0" volts="-10"/>
          <Point input="2000" volts="-5.96"/>
          <Point input="4000" volts="-1.92"/>
          <Point input="4950" volts="0"/>
          <Point input="6000" volts="2.12"/>
          <Point input="8000" volts="6.16"/>
          <Point input="9900" volts="10"/>
        </Breakpoints>
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
  </Channels>
</Simtek100295HardwareSupportModule>