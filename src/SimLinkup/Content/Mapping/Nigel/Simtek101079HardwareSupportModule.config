<?xml version="1.0"?>
<Simtek101079HardwareSupportModule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Channels>
    <Channel id="101079_Compass__SIN_To_Instrument">
      <Transform kind="piecewise_resolver" role="sin" partnerChannel="101079_Compass__COS_To_Instrument">
        <Breakpoints>
          <Point input="0" angle="0"/>
          <Point input="30" angle="30"/>
          <Point input="60" angle="60"/>
          <Point input="90" angle="90"/>
          <Point input="120" angle="120"/>
          <Point input="150" angle="150"/>
          <Point input="180" angle="180"/>
          <Point input="210" angle="210"/>
          <Point input="240" angle="240"/>
          <Point input="270" angle="270"/>
          <Point input="300" angle="300"/>
          <Point input="330" angle="330"/>
          <Point input="360" angle="360"/>
        </Breakpoints>
        <PeakVolts>10</PeakVolts>
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
    <Channel id="101079_Compass__COS_To_Instrument">
      <Transform kind="piecewise_resolver" role="cos" partnerChannel="101079_Compass__SIN_To_Instrument">
      </Transform>
      <ZeroTrimVolts>0</ZeroTrimVolts>
      <GainTrim>1</GainTrim>
    </Channel>
  </Channels>
</Simtek101079HardwareSupportModule>